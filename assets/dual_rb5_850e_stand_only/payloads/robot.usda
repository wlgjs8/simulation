"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "dual_rb5_850e_stand_only" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </dual_rb5_850e_stand_only/Physics/stand_fixed>,
        </dual_rb5_850e_stand_only/Physics/stand_collision_fixed>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </dual_rb5_850e_stand_only/Geometry/world/base/stand>,
        </dual_rb5_850e_stand_only/Geometry/world/base/stand/stand_left_arm_base>,
        </dual_rb5_850e_stand_only/Geometry/world/base/stand/stand_right_arm_base>,
        </dual_rb5_850e_stand_only/Geometry/world/base/stand/stand_collision>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "base"
            {
                over "stand" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "stand_collision" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }

                    over "stand_left_arm_base" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }

                    over "stand_right_arm_base" (
                        prepend apiSchemas = ["IsaacSiteAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "stand_fixed" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "stand_collision_fixed" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

