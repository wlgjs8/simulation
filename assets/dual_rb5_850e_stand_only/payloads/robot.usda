#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "dual_rb5_850e_stand_only"
    doc = """Generated from Composed Stage of root layer /tmp/tmp1s08jhha/dual_rb5_850e_stand_only.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_dual_rb5_850e_stand_only_uuociumh/usdex_dual_rb5_850e_stand_only/dual_rb5_850e_stand_only.usdc


