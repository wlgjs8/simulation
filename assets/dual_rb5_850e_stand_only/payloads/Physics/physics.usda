"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "dual_rb5_850e_stand_only"
{
    over "Geometry"
    {
        over "world"
        {
            over "base" (
                prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
            )
            {
                bool newton:selfCollisionEnabled = 0

                over "stand" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                    over "stand_collision" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "stand_fixed"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </dual_rb5_850e_stand_only/Geometry/world/base>
            custom rel physics:body1
            prepend rel physics:body1 = </dual_rb5_850e_stand_only/Geometry/world/base/stand>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "stand_collision_fixed"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </dual_rb5_850e_stand_only/Geometry/world/base/stand>
            custom rel physics:body1
            prepend rel physics:body1 = </dual_rb5_850e_stand_only/Geometry/world/base/stand/stand_collision>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

